# SimuPatient environment example
#
# The Streamlit app reads Streamlit secrets first, then environment variables.
# For local Streamlit development, prefer .streamlit/secrets.toml.

APP_NAME=SimuPatient
APP_ENV=development
APP_VERSION=2.0.0
DEBUG=false

# SQLite is the default local database.
DATABASE_URL=sqlite:///simupatient.db

# Provider selection: mock, gemini, or ollama.
LLM_PROVIDER=mock

# Gemini configuration. Tests and mock local runs do not require a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7

LOG_LEVEL=INFO
