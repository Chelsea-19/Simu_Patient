# SimuPatient Streamlit Cloud Secrets Example
# Rename this to secrets.toml and place it in the .streamlit/ folder for local testing
# In Streamlit Community Cloud, paste these into the app's Secrets settings.

# Use mock for deterministic local/dev runs without external API calls.
LLM_PROVIDER = "mock"

# For Gemini runs, set LLM_PROVIDER = "gemini" and add a key from
# https://aistudio.google.com/
GEMINI_API_KEY = "your_google_ai_api_key_here"

# Recommended: gemini-2.5-flash-lite as the cheapest, most efficient API
GEMINI_MODEL = "gemini-2.5-flash-lite"
